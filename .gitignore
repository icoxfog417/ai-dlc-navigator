# This repo holds the ai-dlc-navigator skill (skills/). AI-DLC trial runs in this
# folder stay local: `aidlc config` manages these paths. The local link
# .claude/skills/ai-dlc-navigator -> ../../skills/ai-dlc-navigator is ignored too
# (gh skill publish warns when .claude/skills/ is committed); see README.
/.claude/
/aidlc/
/aidlc.settings.json
/aidlc.settings.local.json
/.mcp.json

# Engine folders AI-DLC writes for other harnesses
/.kiro/
/.codex/
/.cursor/
/.aidlc/
/.opencode/
/.agents/

# Never commit an update in progress (scripts/update-aidlc-docs.sh)
skills/*/references/.update.*
